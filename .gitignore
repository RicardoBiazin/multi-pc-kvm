# Artefatos de compilacao (o .exe vai como Release, nao no historico)
build/
dist/
# `dist-novo` e' onde o empacotador escreve quando o .exe de `dist` esta' em uso
# (o programa aberto o trava). Sem esta linha um `git add -A` leva 35 MB de
# binario para o historico -- e num repositorio publico isso nao sai mais.
dist-novo/
*.spec
icone.ico
versao.txt

# Configuracao e diagnostico da maquina local: contem a CHAVE compartilhada,
# nomes de PC e IPs da rede. Nunca versionar.
config.json
*.log
servidor-*.txt
cliente-*.txt
relatorio*.txt
# Bilhete do agente para o servico: o desktop de entrada da maquina local.
servico-desktop.txt

__pycache__/
*.py[cod]
